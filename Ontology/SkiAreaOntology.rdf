    <!-- http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiArea -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiLift"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiRun"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiArea"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiLift -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiLift">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isLiftOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiArea"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiLift"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiRun"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiRun -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiRun">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isRunOf"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiArea"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiRun"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isLiftOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isLiftOf">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#hasSkiArea"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiLift"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#SkiArea"/>
        <owl:propertyDisjointWith rdf:resource="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isRunOf"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isRunOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/dasum/ontologies/2026/1/ski-map-ontology#isRunOf">
